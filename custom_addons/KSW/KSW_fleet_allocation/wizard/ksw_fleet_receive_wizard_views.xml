<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksw_fleet_receive_wizard_form" model="ir.ui.view">
        <field name="name">ksw.fleet.receive.wizard.form</field>
        <field name="model">ksw.fleet.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Arrival">
                <div class="text-muted mb-2">
                    Record the odometer and the state each vehicle arrived in. Anything other than
                    Good needs a note, and the GM is told.
                </div>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_id" column_invisible="True"/>
                        <field name="vehicle_id" readonly="1"/>
                        <field name="from_department_id" readonly="1"/>
                        <field name="odometer"/>
                        <field name="condition"/>
                        <field name="note" required="condition != 'good'"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Arrival" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
