<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_ksw_fleet_allocation" model="ir.ui.view">
        <field name="name">res.users.form.ksw.fleet.allocation</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group groups="base.group_erp_manager" string="Vehicle Allocation">
                    <field name="x_fleet_department_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="The departments whose vehicles he releases, requests and receives..."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Everything about who works in this app on one screen: the role and
         the departments, side by side. Naming departments grants the
         Department User role by itself (res.users._ksw_fleet_grant_user_role). -->
    <record id="view_users_list_ksw_fleet_allocation" model="ir.ui.view">
        <field name="name">res.users.list.ksw.fleet.allocation</field>
        <field name="model">res.users</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Department Users" editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1" optional="show"/>
                <field name="x_fleet_department_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="x_fleet_role" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_users_search_ksw_fleet_allocation" model="ir.ui.view">
        <field name="name">res.users.search.ksw.fleet.allocation</field>
        <field name="model">res.users</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="x_fleet_department_ids"/>
                <filter string="In this App" name="filter_fleet" domain="[('x_fleet_role', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ksw_fleet_department_users" model="ir.actions.act_window">
        <field name="name">Department Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="context">{'search_default_filter_fleet': 1}</field>
        <field name="search_view_id" ref="view_users_search_ksw_fleet_allocation"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_users_list_ksw_fleet_allocation')})]"/>
        <field name="help" type="html">
            <p>Clear the "In this App" filter to find a user, then name his departments: that gives
               him the app. Make someone GM in his Access Rights.</p>
        </field>
    </record>
</odoo>
