<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- main_data_model_ids is deliberately empty on both dashboards. Core only
         uses it to decide whether to show a sample dashboard, by counting each
         model AS THE VIEWER (spreadsheet.dashboard._dashboard_is_empty); one
         model the viewer cannot read made the whole dashboard answer 403 for
         every HR role (none can read payslips). Neither dashboard ships a sample.

         Each audience below can read every model its charts use; the payroll
         chart lives on its own dashboard for the payroll roles. -->
    <record id="spreadsheet_dashboard_ksw_hr" model="spreadsheet.dashboard">
        <field name="name">KSW HR Overview</field>
        <field name="spreadsheet_binary_data" type="base64"
               file="KSW_hr_dashboard/data/files/ksw_hr_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.clear()]"/>
        <field name="dashboard_group_id"
               ref="spreadsheet_dashboard.spreadsheet_dashboard_group_hr"/>
        <field name="group_ids" eval="[Command.set([
            ref('hr.group_hr_manager'),
            ref('om_hr_payroll.group_hr_payroll_manager'),
            ref('KSW_annual_leave.group_annual_leave_hr'),
            ref('KSW_attendance_sheet.group_attendance_sheet_manager'),
        ])]"/>
        <field name="sequence">10</field>
        <field name="is_published">True</field>
    </record>

    <record id="spreadsheet_dashboard_ksw_payroll" model="spreadsheet.dashboard">
        <field name="name">KSW Payroll Overview</field>
        <field name="spreadsheet_binary_data" type="base64"
               file="KSW_hr_dashboard/data/files/ksw_payroll_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.clear()]"/>
        <field name="dashboard_group_id"
               ref="spreadsheet_dashboard.spreadsheet_dashboard_group_hr"/>
        <field name="group_ids" eval="[Command.set([
            ref('om_hr_payroll.group_hr_payroll_user'),
            ref('om_hr_payroll.group_hr_payroll_manager'),
        ])]"/>
        <field name="sequence">20</field>
        <field name="is_published">True</field>
    </record>

</odoo>
