<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ksw_signature_reset_wizard_form" model="ir.ui.view">
        <field name="name">ksw.signature.reset.wizard.form</field>
        <field name="model">ksw.signature.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Signed Document">
                <p>The document goes back to draft. The signed PDF, its fingerprint
                    and your reason are kept in the document history.</p>
                <field name="document_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why must this signed document change?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reset to Draft" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_ksw_signature_verify_wizard_form" model="ir.ui.view">
        <field name="name">ksw.signature.verify.wizard.form</field>
        <field name="model">ksw.signature.verify.wizard</field>
        <field name="arch" type="xml">
            <form string="Verify a Signed PDF">
                <p>Upload a signed PDF to check it was signed here and has not been changed since.</p>
                <group>
                    <field name="pdf_filename" invisible="1"/>
                    <field name="pdf_file" filename="pdf_filename"/>
                    <field name="file_sha256" invisible="not pdf_file"/>
                </group>
                <field name="matched" invisible="1"/>
                <field name="result" readonly="1" invisible="not pdf_file"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ksw_signature_verify_wizard" model="ir.actions.act_window">
        <field name="name">Verify a Signed PDF</field>
        <field name="res_model">ksw.signature.verify.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_ksw_wacom_signature_verify"
              name="Verify a Signed PDF"
              parent="menu_ksw_wacom_signature_root"
              action="action_ksw_signature_verify_wizard"
              sequence="5"/>

</odoo>
