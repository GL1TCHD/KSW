<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_ksw_wacom_signature" model="ir.module.category">
        <field name="name">KSW Wacom Signature</field>
        <field name="sequence">205</field>
    </record>

    <record id="privilege_wacom_signature" model="res.groups.privilege">
        <field name="name">Signature Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_wacom_signature"/>
    </record>

    <record id="group_wacom_signature_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_wacom_signature"/>
        <field name="comment">Can upload PDFs, capture a signature and sign their own documents.</field>
    </record>

    <record id="group_wacom_signature_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="privilege_wacom_signature"/>
        <field name="implied_ids" eval="[(4, ref('group_wacom_signature_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Can see and manage every signature document, and reset a signed document back to draft.</field>
    </record>

    <!-- Users see/manage only the documents they created -->
    <record id="ksw_signature_document_rule_own" model="ir.rule">
        <field name="name">Wacom Signature: own documents only</field>
        <field name="model_id" ref="model_ksw_signature_document"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_wacom_signature_user'))]"/>
    </record>

    <!-- Managers see/manage every document -->
    <record id="ksw_signature_document_rule_manager" model="ir.rule">
        <field name="name">Wacom Signature: manager sees all</field>
        <field name="model_id" ref="model_ksw_signature_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_wacom_signature_manager'))]"/>
    </record>

</odoo>
