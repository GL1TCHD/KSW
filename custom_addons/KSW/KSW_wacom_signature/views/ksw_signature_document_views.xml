<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ksw_signature_document_form" model="ir.ui.view">
        <field name="name">ksw.signature.document.form</field>
        <field name="model">ksw.signature.document</field>
        <field name="arch" type="xml">
            <form string="Signature Document">
                <header>
                    <button name="action_apply_signature" string="Apply Signature to PDF"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_verify_integrity" string="Verify Integrity"
                            type="object"
                            invisible="state != 'signed'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'signed'"
                            groups="KSW_wacom_signature.group_wacom_signature_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Offer Letter - John Doe"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="signer_name"/>
                            <field name="signature_reason"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="capture_method" readonly="1"/>
                            <field name="has_biometric_data" readonly="1" invisible="not capture_method"/>
                            <field name="signed_uid" readonly="1" invisible="not signed_uid"/>
                            <field name="signed_date" readonly="1" invisible="not signed_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Source Document" name="source">
                            <group>
                                <field name="source_pdf_filename" invisible="1"/>
                                <field name="source_pdf" filename="source_pdf_filename"
                                       widget="pdf_viewer" readonly="state != 'draft'"/>
                                <field name="source_pdf_sha256" invisible="not source_pdf_sha256"/>
                            </group>
                        </page>
                        <page string="Signature" name="signature">
                            <group>
                                <field name="signature_image" widget="signature"
                                       readonly="state != 'draft'"
                                       options="{'full_name': 'signer_name'}"/>
                                <field name="signature_sigtext" invisible="1"/>
                                <widget name="ksw_wacom_capture_signature"
                                        string="Capture from Wacom Pad"
                                        signature_field="signature_image"
                                        capture_method_field="capture_method"
                                        sigtext_field="signature_sigtext"
                                        bind_hash_field="source_pdf_sha256"
                                        full_name="signer_name"
                                        invisible="state != 'draft'"/>
                            </group>
                            <group string="Placement on PDF">
                                <field name="page_number" readonly="state != 'draft'"/>
                                <field name="pos_x" readonly="state != 'draft'"/>
                                <field name="pos_y" readonly="state != 'draft'"/>
                                <field name="sig_width" readonly="state != 'draft'"/>
                                <field name="sig_height" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Signed Document" name="signed" invisible="state != 'signed'">
                            <group>
                                <field name="signed_pdf_filename" invisible="1"/>
                                <field name="signed_pdf" filename="signed_pdf_filename"
                                       widget="pdf_viewer" readonly="1"/>
                                <field name="signed_pdf_sha256"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ksw_signature_document_list" model="ir.ui.view">
        <field name="name">ksw.signature.document.list</field>
        <field name="model">ksw.signature.document</field>
        <field name="arch" type="xml">
            <list string="Signature Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="signer_name"/>
                <field name="capture_method"/>
                <field name="state" widget="badge" decoration-success="state == 'signed'"
                       decoration-muted="state == 'draft'"/>
                <field name="signed_date"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_signature_document_search" model="ir.ui.view">
        <field name="name">ksw.signature.document.search</field>
        <field name="model">ksw.signature.document</field>
        <field name="arch" type="xml">
            <search string="Search Signature Documents">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="signer_name"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_signed" string="Signed" domain="[('state', '=', 'signed')]"/>
                <group>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_signature_document" model="ir.actions.act_window">
        <field name="name">Signature Documents</field>
        <field name="res_model">ksw.signature.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_signature_document_search"/>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload a PDF and sign it with your Wacom pad
            </p>
        </field>
    </record>

    <menuitem id="menu_ksw_wacom_signature_root"
              name="Signatures"
              sequence="95"
              groups="KSW_wacom_signature.group_wacom_signature_user"/>

    <menuitem id="menu_ksw_wacom_signature_documents"
              name="Signature Documents"
              parent="menu_ksw_wacom_signature_root"
              action="action_ksw_signature_document"
              sequence="1"/>

</odoo>
