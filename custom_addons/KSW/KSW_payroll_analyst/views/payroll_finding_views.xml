<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksw_payroll_finding_list" model="ir.ui.view">
        <field name="name">ksw.payroll.finding.list</field>
        <field name="model">ksw.payroll.finding</field>
        <field name="arch" type="xml">
            <list string="Payroll Check Findings" create="0" delete="0"
                  decoration-danger="severity == 'critical' and state == 'open'"
                  decoration-warning="severity == 'warning' and state == 'open'"
                  decoration-muted="state == 'reviewed'">
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'warning'"
                       decoration-info="severity == 'info'"/>
                <field name="check_code" optional="hide"/>
                <field name="employee_id"/>
                <field name="slip_id"/>
                <field name="title"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'reviewed'"/>
                <field name="review_note" optional="show"/>
                <button name="action_mark_reviewed" type="object"
                        string="Reviewed" icon="fa-check"
                        invisible="state != 'open'"
                        groups="om_hr_payroll.group_hr_payroll_user"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_payroll_finding_form" model="ir.ui.view">
        <field name="name">ksw.payroll.finding.form</field>
        <field name="model">ksw.payroll.finding</field>
        <field name="arch" type="xml">
            <form string="Payroll Check Finding" create="0" delete="0">
                <header>
                    <button name="action_mark_reviewed" type="object"
                            string="Mark Reviewed" class="btn-primary"
                            invisible="state != 'open'"
                            groups="om_hr_payroll.group_hr_payroll_user"/>
                    <button name="action_reopen" type="object"
                            string="Reopen"
                            invisible="state != 'reviewed'"
                            groups="om_hr_payroll.group_hr_payroll_user"/>
                    <button name="action_open_slip" type="object"
                            string="Open Payslip" invisible="not slip_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h2><field name="title"/></h2>
                    <group>
                        <group>
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'critical'"
                                   decoration-warning="severity == 'warning'"
                                   decoration-info="severity == 'info'"/>
                            <field name="check_code"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="run_id"/>
                            <field name="employee_id"/>
                            <field name="slip_id"/>
                        </group>
                    </group>
                    <field name="detail" nolabel="1"/>
                    <group string="Review">
                        <field name="review_note"
                               placeholder="Why this is fine, or what was done about it"/>
                        <field name="reviewed_by" invisible="not reviewed_by"/>
                        <field name="reviewed_on" invisible="not reviewed_on"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ksw_payroll_finding_search" model="ir.ui.view">
        <field name="name">ksw.payroll.finding.search</field>
        <field name="model">ksw.payroll.finding</field>
        <field name="arch" type="xml">
            <search string="Payroll Check Findings">
                <field name="employee_id"/>
                <field name="slip_id"/>
                <field name="run_id"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="reviewed" string="Reviewed" domain="[('state', '=', 'reviewed')]"/>
                <separator/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <filter name="warning" string="Warning" domain="[('severity', '=', 'warning')]"/>
                <filter name="info" string="Info" domain="[('severity', '=', 'info')]"/>
                <group>
                    <filter name="group_check" string="Check" context="{'group_by': 'check_code'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_run" string="Batch" context="{'group_by': 'run_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_payroll_finding" model="ir.actions.act_window">
        <field name="name">Payroll Check Findings</field>
        <field name="res_model">ksw.payroll.finding</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_payroll_finding_search"/>
        <field name="context">{'search_default_open': 1, 'search_default_group_run': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No findings</p>
            <p>Open a payslip batch and press <strong>Check Payroll</strong>.
               Draft batches are also checked every night.</p>
        </field>
    </record>

    <menuitem id="menu_ksw_payroll_finding"
              name="Payroll Check Findings"
              parent="om_hr_payroll.menu_hr_payroll_root"
              action="action_ksw_payroll_finding"
              groups="KSW_payroll.group_hr_payroll_reviewer"
              sequence="25"/>
</odoo>
