<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Re-checks every draft batch overnight so the findings on the
             batch are never older than a day. Read-only on payroll data:
             it only replaces the batch's findings. -->
        <record id="ir_cron_payroll_analyst" model="ir.cron">
            <field name="name">Payroll Analyst: check draft batches</field>
            <field name="model_id" ref="model_hr_payslip_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_ksw_analyze_draft_runs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
