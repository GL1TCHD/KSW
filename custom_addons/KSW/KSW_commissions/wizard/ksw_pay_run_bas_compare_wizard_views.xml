<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ksw_pay_run_bas_compare_wizard_form" model="ir.ui.view">
        <field name="name">ksw.pay.run.bas.compare.wizard.form</field>
        <field name="model">ksw.pay.run.bas.compare.wizard</field>
        <field name="arch" type="xml">
            <form string="Compare with BAS">
                <div class="alert alert-info" role="status">
                    The voucher is read from BAS (nothing is written to BAS)
                    and laid beside the month. The month itself does not
                    change.
                </div>
                <group>
                    <field name="run_id"/>
                    <field name="voucher_number" placeholder="26008282"/>
                </group>
                <footer>
                    <button name="action_compare" type="object"
                            string="Compare" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
