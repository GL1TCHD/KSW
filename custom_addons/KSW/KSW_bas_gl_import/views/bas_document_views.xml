<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksw_bas_document_type_list" model="ir.ui.view">
        <field name="name">ksw.bas.document.type.list</field>
        <field name="model">ksw.bas.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="ftype"/>
                <field name="ftype2"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_ksw_bas_document_type" model="ir.actions.act_window">
        <field name="name">BAS Document Types</field>
        <field name="res_model">ksw.bas.document.type</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_ksw_bas_document_type" name="BAS Document Types"
              parent="account.menu_finance_configuration" action="action_ksw_bas_document_type"
              groups="account.group_account_manager" sequence="91"/>

    <!-- Journal entries, invoices, bills -->
    <record id="view_move_form_bas_document" model="ir.ui.view">
        <field name="name">account.move.form.bas.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="x_bas_document" invisible="not x_bas_document"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_tree_bas_document" model="ir.ui.view">
        <field name="name">account.move.list.bas.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="x_bas_document" optional="show"/>
            </field>
        </field>
    </record>
    <record id="view_invoice_tree_bas_document" model="ir.ui.view">
        <field name="name">account.invoice.list.bas.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_partner_display_name" position="after">
                <field name="x_bas_document" optional="show"/>
            </field>
        </field>
    </record>
    <record id="view_account_move_filter_bas_document" model="ir.ui.view">
        <field name="name">account.move.filter.bas.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_bas_document"/>
            </field>
        </field>
    </record>
    <record id="view_account_invoice_filter_bas_document" model="ir.ui.view">
        <field name="name">account.invoice.filter.bas.document</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_bas_document"/>
            </field>
        </field>
    </record>

    <!-- Payments -->
    <record id="view_account_payment_form_bas_document" model="ir.ui.view">
        <field name="name">account.payment.form.bas.document</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="memo" position="after">
                <field name="x_bas_document" invisible="not x_bas_document"/>
            </field>
        </field>
    </record>
    <record id="view_account_payment_tree_bas_document" model="ir.ui.view">
        <field name="name">account.payment.list.bas.document</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_bas_document" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Transfers: receipts, issues, delivery notes -->
    <record id="view_picking_form_bas_document" model="ir.ui.view">
        <field name="name">stock.picking.form.bas.document</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="x_bas_document" invisible="not x_bas_document"/>
            </field>
        </field>
    </record>
    <record id="view_picking_tree_bas_document" model="ir.ui.view">
        <field name="name">stock.picking.list.bas.document</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="x_bas_document" optional="show"/>
            </field>
        </field>
    </record>
    <record id="view_picking_search_bas_document" model="ir.ui.view">
        <field name="name">stock.picking.search.bas.document</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="x_bas_document"/>
            </field>
        </field>
    </record>
</odoo>
