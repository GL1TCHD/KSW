<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="it_asset_assignment_view_list" model="ir.ui.view">
        <field name="name">it.asset.assignment.list</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'returned'">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="category_id" optional="hide"/>
                <field name="date_assigned"/>
                <field name="date_expected_return" optional="hide"/>
                <field name="date_returned"/>
                <field name="condition_out" optional="hide"/>
                <field name="condition_in" optional="hide"/>
                <field name="assigned_by" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="it_asset_assignment_view_form" model="ir.ui.view">
        <field name="name">it.asset.assignment.form</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Handover">
                            <field name="asset_id" readonly="id"
                                   domain="[('state', '=', 'available')]"
                                   options="{'no_create': True}"/>
                            <field name="employee_id" readonly="id" options="{'no_create': True}"/>
                            <field name="assigned_by"/>
                            <field name="accessories" readonly="state != 'active'"/>
                        </group>
                        <group string="Dates &amp; Status">
                            <field name="date_assigned" readonly="state != 'active'"/>
                            <field name="date_expected_return" readonly="state != 'active'"/>
                            <field name="date_returned" invisible="state != 'returned'"/>
                            <field name="condition_out" readonly="state != 'active'"/>
                            <field name="condition_in" invisible="state != 'returned'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pop-up opened by the asset form's "Assign to Employee" button.
         Saving it creates the assignment and marks the asset assigned
         (see it.asset.assignment.create). KSW_asset_handover adds a
         "Save &amp; Sign" button here for the signed handover form. -->
    <record id="it_asset_assignment_view_form_dialog" model="ir.ui.view">
        <field name="name">it.asset.assignment.form.dialog</field>
        <field name="model">it.asset.assignment</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Assign Asset">
                <group>
                    <group>
                        <field name="asset_id" readonly="1"/>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="accessories" placeholder="e.g. Charger, bag, mouse"/>
                    </group>
                    <group>
                        <field name="date_assigned"/>
                        <field name="date_expected_return"/>
                        <field name="condition_out" string="Condition"/>
                    </group>
                </group>
                <field name="notes" placeholder="Notes..."/>
                <footer>
                    <button special="save" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="it_asset_assignment_view_search" model="ir.ui.view">
        <field name="name">it.asset.assignment.search</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="it_asset_assignment_action" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">it.asset.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
