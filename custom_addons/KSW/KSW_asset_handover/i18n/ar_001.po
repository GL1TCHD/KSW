#. module: KSW_asset_handover
#: model_terms:ir.ui.view,arch_db:KSW_asset_handover.report_it_asset_handover
msgid ""
"I, the undersigned, acknowledge receipt of the above asset in the\n"
"                            stated condition. I agree to use it for work purposes only, keep\n"
"                            it safe, report any damage, loss or theft to the IT Team\n"
"                            immediately, and return it with all accessories when requested or\n"
"                            when my employment ends."
msgstr ""
"أقر أنا الموقّع أدناه باستلام العهدة المذكورة أعلاه بالحالة\n"
"                            المبينة، وأتعهد باستخدامها لأغراض العمل فقط والمحافظة\n"
"                            عليها، وإبلاغ فريق تقنية المعلومات فوراً بأي تلف أو فقدان أو سرقة،\n"
"                            وإعادتها مع جميع ملحقاتها عند الطلب أو\n"
"                            عند انتهاء خدمتي."

