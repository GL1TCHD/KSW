<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A user reads only his own questions; administrators read all (the log). -->
    <record id="rule_ksw_ai_conversation_own" model="ir.rule">
        <field name="name">AI conversation: own</field>
        <field name="model_id" ref="model_ksw_ai_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_ksw_ai_conversation_admin" model="ir.rule">
        <field name="name">AI conversation: administrator all</field>
        <field name="model_id" ref="model_ksw_ai_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_ksw_ai_turn_own" model="ir.rule">
        <field name="name">AI question: own</field>
        <field name="model_id" ref="model_ksw_ai_turn"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_ksw_ai_turn_admin" model="ir.rule">
        <field name="name">AI question: administrator all</field>
        <field name="model_id" ref="model_ksw_ai_turn"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
