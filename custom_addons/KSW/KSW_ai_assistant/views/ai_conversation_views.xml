<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksw_ai_turn_list" model="ir.ui.view">
        <field name="name">ksw.ai.turn.list</field>
        <field name="model">ksw.ai.turn</field>
        <field name="arch" type="xml">
            <list string="AI Assistant Questions" create="0" edit="0">
                <field name="create_date" string="Asked On"/>
                <field name="user_id"/>
                <field name="question"/>
                <field name="model" optional="hide"/>
                <field name="input_tokens" optional="show" sum="Total"/>
                <field name="cached_tokens" optional="hide" sum="Total"/>
                <field name="output_tokens" optional="show" sum="Total"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_ksw_ai_turn_form" model="ir.ui.view">
        <field name="name">ksw.ai.turn.form</field>
        <field name="model">ksw.ai.turn</field>
        <field name="arch" type="xml">
            <form string="AI Assistant Question" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date" string="Asked On"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="input_tokens"/>
                            <field name="cached_tokens"/>
                            <field name="output_tokens"/>
                            <field name="error"/>
                        </group>
                    </group>
                    <separator string="Question"/>
                    <field name="question" nolabel="1"/>
                    <separator string="Answer"/>
                    <field name="answer" nolabel="1"/>
                    <separator string="What It Ran"/>
                    <field name="tool_calls_text" nolabel="1" widget="text" class="font-monospace"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ksw_ai_turn_search" model="ir.ui.view">
        <field name="name">ksw.ai.turn.search</field>
        <field name="model">ksw.ai.turn</field>
        <field name="arch" type="xml">
            <search>
                <field name="question"/>
                <field name="user_id"/>
                <filter name="errors" string="Errors" domain="[('error', '!=', False)]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_ksw_ai_turn" model="ir.actions.act_window">
        <field name="name">AI Assistant Questions</field>
        <field name="res_model">ksw.ai.turn</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
