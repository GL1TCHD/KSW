<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- utm ships a top-level "Link Tracker" app whose only content, without
         the link_tracker module, is the UTMs folder (Campaigns, Mediums,
         Sources): marketing plumbing nobody here works in. It goes under
         Settings > Technical with the other technical tables, and the app
         disappears from the switcher on its own: a menu with no action is
         only shown while it has a visible child. write() rather than a
         <menuitem> override, which would reset what it does not repeat
         (gotcha #1). -->
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('utm.marketing_utm')]"/>
        <value eval="{'parent_id': ref('base.menu_custom'), 'sequence': 40}"/>
    </function>

    <!-- The Apps installer is declared groups="base.group_system" in base, but
         odoo_dev had lost that (no groups at all), so every employee saw
         "Apps" on Home. A one-time edit in the database survives upgrades of
         a non-noupdate menu only until something rewrites it, so state it here
         (gotcha #3). -->
    <!-- Settings likewise, on request (Nov 2026): core also opens it to
         Access Rights (group_erp_manager); here only System Administrators
         see either app. -->
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('base.menu_management'), ref('base.menu_administration')]"/>
        <value eval="{'group_ids': [(6, 0, [ref('base.group_system')])]}"/>
    </function>
</odoo>
