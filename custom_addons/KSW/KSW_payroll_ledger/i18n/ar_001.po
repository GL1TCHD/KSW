#. module: KSW_payroll_ledger
#: model_terms:ir.ui.view,arch_db:KSW_payroll_ledger.res_config_settings_view_form_ledger
msgid ""
"Payslip batches and paid commission months from this date are\n"
"                                posted to the ledger. Months already exported to BAS stay out."
msgstr ""
"تُرحَّل إلى دفتر الأستاذ دفعات الرواتب وأشهر العمولات المدفوعة اعتباراً من "
"هذا التاريخ. الأشهر المصدَّرة إلى BAS لا تُرحَّل."

#. module: KSW_payroll_ledger
#: model:ir.model.fields,field_description:KSW_payroll_ledger.field_res_config_settings__ksw_ledger_start_date
msgid "Post payroll and commissions from"
msgstr "ترحيل الرواتب والعمولات اعتباراً من"

