<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Plain strings, no reference to the owning modules: a counter whose model
         is not installed is skipped at count time. noupdate so an admin's edits stay. -->
    <record id="inbox_leave_approvals" model="ksw.home.inbox.source">
        <field name="name">Time off awaiting my approval</field>
        <field name="sequence">10</field>
        <field name="model_name">hr.leave</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-plane</field>
    </record>
    <record id="inbox_deductions" model="ksw.home.inbox.source">
        <field name="name">Loans and deductions awaiting my action</field>
        <field name="sequence">20</field>
        <field name="model_name">ksw.deduction</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-money</field>
    </record>
    <record id="inbox_revisions" model="ksw.home.inbox.source">
        <field name="name">Salary revisions awaiting my action</field>
        <field name="sequence">30</field>
        <field name="model_name">ksw.payslip.revision.request</field>
        <field name="domain">[('is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-pencil-square-o</field>
    </record>
    <record id="inbox_commission_submissions" model="ksw.home.inbox.source">
        <field name="name">Commission submissions to approve</field>
        <field name="sequence">40</field>
        <field name="model_name">ksw.pay.submission</field>
        <field name="domain">[('state', '=', 'submitted'), ('gm_id', '=', uid)]</field>
        <field name="icon">fa-check-square-o</field>
    </record>
    <record id="inbox_purchase_requests" model="ksw.home.inbox.source">
        <field name="name">Purchase requests to approve</field>
        <field name="sequence">50</field>
        <field name="model_name">purchase.request</field>
        <field name="domain">[('state', '=', 'to_approve'), ('assigned_to', '=', uid)]</field>
        <field name="icon">fa-shopping-cart</field>
    </record>
    <record id="inbox_helpdesk_tickets" model="ksw.home.inbox.source">
        <field name="name">Open tickets assigned to me</field>
        <field name="sequence">60</field>
        <field name="model_name">helpdesk.ticket</field>
        <field name="domain">[('user_id', '=', uid), ('stage_id.fold', '=', False)]</field>
        <field name="icon">fa-life-ring</field>
    </record>
</odoo>
